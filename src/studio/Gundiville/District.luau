--!strict
-- Builds the whole Gundiville government district into one folder: streets, square, General
-- People's Congress, Hausali, central bank, the Leader's residence and the statue. Used by
-- StudioTools.BuildGundiville; the tests call it directly.

local Kit = require(script.Parent.Kit)
local Streets = require(script.Parent.Streets)
local Square = require(script.Parent.Square)
local Congress = require(script.Parent.Congress)
local Hausali = require(script.Parent.Hausali)
local CentralBank = require(script.Parent.CentralBank)
local Residence = require(script.Parent.Residence)
local Statue = require(script.Parent.Statue)
local Util = require(script.Parent.Parent.Map.Builders.Util)

local District = {}

District.FolderName = "GovernmentDistrict"

export type Report = {
	Parts: number,
	Lift: number, -- studs above the planned ground (Ground.luau)
	PartsBy: { [string]: number },
	Streets: { [string]: number },
	Square: { [string]: number },
	Congress: { [string]: number },
	Hausali: { [string]: number },
	CentralBank: { [string]: number },
	Residence: { [string]: number },
	Statue: Statue.Report,
}

-- A new, unparented district folder marked as generated by BuildGundiville.
function District.newFolder(config: any): Folder
	local folder = Instance.new("Folder")
	folder.Name = District.FolderName
	folder:SetAttribute("GeneratedBy", config.GeneratedBy)
	folder:SetAttribute("DistrictVersion", config.Version)
	return folder
end

-- `config` is the plan (GovernmentDistrict), or the plan on surveyed ground (Ground.apply).
function District.build(config: any, folder: Instance, options: Statue.Options?): Report
	Kit.resetCount()
	Kit.setFooting(if config.FootingY then config.GroundY else nil, config.FootingY)
	local partsBy: { [string]: number } = {}
	local function step<T>(name: string, build: () -> T): T
		local before = Kit.partCount()
		local result = build()
		partsBy[name] = Kit.partCount() - before
		Util.yield()
		return result
	end
	local streets = step("Streets", function()
		return Streets.build(config, folder)
	end)
	local square = step("Square", function()
		return Square.build(config, folder)
	end)
	local congress = step("Congress", function()
		return Congress.build(config, folder)
	end)
	local hausali = step("Hausali", function()
		return Hausali.build(config, folder)
	end)
	local bank = step("CentralBank", function()
		return CentralBank.build(config, folder)
	end)
	local residence = step("Residence", function()
		return Residence.build(config, folder)
	end)
	local statue = step("Statue", function()
		return Statue.build(config, folder, options)
	end)
	Kit.setFooting(nil, nil)
	return {
		Parts = Kit.partCount(),
		Lift = config.Lift or 0,
		PartsBy = partsBy,
		Streets = streets,
		Square = square,
		Congress = congress,
		Hausali = hausali,
		CentralBank = bank,
		Residence = residence,
		Statue = statue,
	}
end

return District
