{
  "name": "Ro-Nation",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "StudioTools": {
        "$path": "src/studio"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      }
    },

    "Lighting": {
      "$properties": {
        "ClockTime": 14
      }
    }
  }
}
