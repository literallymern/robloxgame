{
  "name": "Ro-Nation",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "StudioTools": {
        "$path": "src/studio"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 9.5,
        "GeographicLatitude": -2,
        "Brightness": 2.4,
        "Ambient": [
          0.225,
          0.24,
          0.255
        ],
        "OutdoorAmbient": [
          0.38,
          0.39,
          0.39
        ],
        "ColorShift_Top": [
          0,
          0,
          0
        ],
        "EnvironmentDiffuseScale": 0.85,
        "EnvironmentSpecularScale": 0.8,
        "GlobalShadows": true,
        "ShadowSoftness": 0.35,
        "ColorShift_Bottom": [
          0,
          0,
          0
        ],
        "ExposureCompensation": -0.13
      },
      "RoNationAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.235,
          "Offset": 0.15,
          "Color": [
            0.8,
            0.83,
            0.875
          ],
          "Decay": [
            0.38,
            0.43,
            0.51
          ],
          "Glare": 0.07,
          "Haze": 1.05
        }
      },
      "RoNationBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.08,
          "Size": 18,
          "Threshold": 1.8
        }
      },
      "RoNationSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.022,
          "Spread": 0.7
        }
      },
      "RoNationColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0,
          "Contrast": 0.05,
          "Saturation": -0.07,
          "TintColor": [
            1,
            0.995,
            0.985
          ]
        }
      }
    }
  }
}
