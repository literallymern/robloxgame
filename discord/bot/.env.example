# Ro-Nation Economy Bot settings.
# Copy this file to ".env" (same folder) and fill in the values. NEVER commit .env or share the token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# From the same page -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Right-click your server icon -> Copy Server ID (enable Developer Mode in Discord settings first)
DISCORD_GUILD_ID=
# Right-click your own name -> Copy User ID. This account gets the Owner emergency overrides.
OWNER_USER_ID=

# Optional settings (defaults shown)
TIMEZONE=Europe/Berlin
DATABASE_PATH=data/economy.db
BACKUP_DIR=data/backups
BACKUP_KEEP=30
IDS_FILE=data/guild-ids.json
# Discord accounts younger than this cannot verify with the button (moderators can verify them with /mod verify)
MIN_ACCOUNT_AGE_DAYS=7
# Discord accounts younger than this do not receive the one-time starting grant
GRANT_MIN_ACCOUNT_AGE_DAYS=14
# Days until "New Member" becomes "Community Member"
NEW_MEMBER_DAYS=7
# After downtime: publish every missed report (true) or only the newest (false)
CATCHUP_PUBLISH_ALL=false
SCHEDULER_INTERVAL_SECONDS=30
COMMAND_COOLDOWN_SECONDS=3
